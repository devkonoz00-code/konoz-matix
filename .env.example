# Server Configuration
PORT=5000
NODE_ENV=production

# Security & CORS
# Allowed frontend origin for CORS (e.g., https://matix.yourcompany.com or comma-separated list)
FRONTEND_ORIGIN=http://localhost:5000

# MongoDB Connection
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Initial Administrator Account Initialization
# Required for running 'npm run setup'. Must satisfy password complexity requirements.
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=

# JWT Secrets (Must be at least 32 cryptographically random characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_MAX=120

# Cloudinary Storage (Required for product image uploads)
# Configure either CLOUDINARY_URL or all three explicit values below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative single-variable format:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
